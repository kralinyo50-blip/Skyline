# Yalnızca yerel geliştirme. Gerçek sırları Git'e veya VITE_* değişkenlerine koyma.
NODE_ENV=development
PORT=3001
# Boş bırakılırsa yalnızca geliştirmede PGlite kullanılır. Üretimde PostgreSQL zorunlu.
DATABASE_URL=
PGLITE_DIR=.cache/platform-db
# Geliştirmede boş bırak: Vite /api proxy'sinin aynı kökenini kullanır.
# Üretimde örnek: https://sunucun.onrender.com (yol ekleme)
PUBLIC_ORIGIN=
SERVE_DIST=false
# İkisini birlikte doldur; kullanıcı adı 3-16, şifre en az 16 karakter.
# Mevcut oyuncuyu admin yapmaz, mevcut adminin şifresini değiştirmez.
SKYLINE_ADMIN_USER=
SKYLINE_ADMIN_PASSWORD=
# İkisi de ayarlanmadan ücretli üretim açılamaz. Sahte görsel üretimi yoktur.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=20
# İsteğe bağlı: yalnızca yeni merkezi önizlemede varsayılan açar. V2 silinmez.
VITE_PLATFORM_DEFAULT=false
